# ==============================================================================
# MUNICIPAL SERVICE PORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' inside the backend/ folder and customize your values.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Flask Server Settings
FLASK_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000

# Security Keys
# Generate a strong 32+ byte random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Session & Cookie Security
# Set SESSION_COOKIE_SECURE=true when serving over HTTPS in production
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# MongoDB Connection
# Local MongoDB example: mongodb://127.0.0.1:27017/
# Atlas MongoDB example: mongodb+srv://<username>:<password>@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DB_NAME=municipal_civic_portal

# CORS Allowed Origins (comma-separated list of origins)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5000,http://localhost:5000

# File Upload Storage (stored OUTSIDE public static directories)
# Path relative to backend root or an absolute system path
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880  # 5 MB in bytes (per file limit)

# Municipal Portal Branding & Contact Configuration
# Placeholders used throughout the portal as required by clean data rules
PORTAL_MUNICIPALITY_NAME=Municipal Service Portal
PORTAL_CONTACT_PHONE=[Contact phone – to be configured]
PORTAL_CONTACT_EMAIL=[Contact email – to be configured]
PORTAL_OFFICE_ADDRESS=[Office address – to be configured]

# Default Administrator Credentials (for seed script)
ADMIN_EMAIL=admin@municipal.gov
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Municipal Administrator


# ==============================================================================
# MUNICIPAL SERVICE PORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your actual '.env' file or real credentials to GitHub.
# 2. In production, configure these variables in the Render & Vercel dashboards.
# 3. Always URL-encode special characters in your database password (@ -> %40, # -> %23, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# In production (Render), Render assigns PORT automatically (e.g. 10000).
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. CORS & CLIENT ACCESS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# For production, add your live Vercel URL (e.g. https://your-portal.vercel.app).
CLIENT_URL=http://127.0.0.1:5000,http://localhost:5000,https://your-portal.vercel.app

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key used for signing JWT tokens (minimum 32 random characters).
# Generate on Windows PowerShell: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_32_byte_hex_string_here
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. MONGODB ATLAS CLUSTER (Cloud M0 Free Tier)
# ------------------------------------------------------------------------------
# Connection string format:
# mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-subdomain>.mongodb.net/municipal_civic_portal?retryWrites=true&w=majority
MONGODB_DB_NAME=municipal_civic_portal

# Python backend compatibility aliases (if using Python runner)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-subdomain>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=municipal_civic_portal

# ------------------------------------------------------------------------------
# 5. INITIAL SUPER ADMINISTRATOR BOOTSTRAP (npm run seed)
# ------------------------------------------------------------------------------
# Used by 'npm run seed' to create the initial administrative account.
ADMIN_EMAIL=admin@municipal.gov
ADMIN_PASSWORD=Admin@ChangeMe123!
ADMIN_NAME=Municipal Administrator

# ------------------------------------------------------------------------------
# 6. MUNICIPAL BRANDING & CONTACT INFO
# ------------------------------------------------------------------------------
PORTAL_MUNICIPALITY_NAME=Municipal Service Portal
PORTAL_CONTACT_PHONE=+91-1800-CIVIC-00
PORTAL_CONTACT_EMAIL=support@municipal.gov
PORTAL_OFFICE_ADDRESS=Civic Center, Central Municipal Ward, City Hall

# ------------------------------------------------------------------------------
# 7. CLOUD FILE STORAGE (Cloudinary Free Tier)
# ------------------------------------------------------------------------------
# Critical for Render free tier because Render local disk is ephemeral!
# Set STORAGE_BACKEND=cloudinary in production, or STORAGE_BACKEND=local for offline dev.
STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Maximum upload limit per file in megabytes (PDF, JPG, PNG)
MAX_UPLOAD_MB=5
